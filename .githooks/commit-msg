#!/bin/sh
# 校验提交信息是否符合 .gitmessage 模板。
# 用法：.githooks/commit-msg <commit-msg-file>

msg_file="$1"

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    echo "commit-msg: 无法读取提交信息文件" >&2
    exit 1
fi

# 去掉注释行和空行，取第一行作为 header。
header=$(grep -v '^[[:space:]]*#' "$msg_file" \
    | tr -d '\r' \
    | sed '/^[[:space:]]*$/d' \
    | head -n 1)

if [ -z "$header" ]; then
    echo "commit-msg: 提交信息不能为空" >&2
    echo "请使用 .gitmessage 模板：<type>(<scope>): <subject>" >&2
    exit 1
fi

# Git 自动生成的合并/回滚/fixup 提交放行。
case "$header" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
        exit 0
        ;;
esac

if ! printf '%s\n' "$header" \
    | grep -Eq '^(docs|feat|fix|refactor|chore|test|style|perf|ci|build|revert)(\([a-z0-9._/-]+\))?: .+'; then
    echo "commit-msg: 提交信息格式不符合模板" >&2
    echo "要求：<type>(<scope>): <subject>" >&2
    echo "示例：docs(network): 补充 netfilter hook 流程说明" >&2
    echo "当前：$header" >&2
    exit 1
fi

if printf '%s\n' "$header" | grep -Eq '[。.!！?？]$'; then
    echo "commit-msg: subject 结尾不要加句号/句点" >&2
    exit 1
fi

exit 0
